# PublishFlow Environment Variables Example
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="file:./dev.db"

# NextAuth.js (generate secret: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# LinkedIn OAuth (get from LinkedIn Developer Portal)
# https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Anthropic Claude API (get from Anthropic Console)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional: Token encryption (generate: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=""
